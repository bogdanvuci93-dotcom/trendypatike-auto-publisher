# OpenAI API (separate from ChatGPT subscription)
OPENAI_API_KEY=sk-...
TEXT_MODEL=gpt-5
VERIFY_MODEL=gpt-5
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=medium

# Instagram API with Instagram Login
IG_ACCESS_TOKEN=...
IG_USER_ID=...
IG_API_VERSION=v25.0

# Branding
BRAND_GREEN=#037361
BRAND_NAME=TRENDYPATIKE
BRAND_SITE=trendypatike.com

# Publishing safety
DRY_RUN=true
FORCE_RUN=false
MAX_TOPIC_ATTEMPTS=3

# Public image hosting. Leave empty in GitHub Actions if the repo is public;
# the bot automatically uses raw.githubusercontent.com.
PUBLIC_BASE_URL=
